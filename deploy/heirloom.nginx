# The application server serves the landing page, workspace, dashboard,
# evidence files and API from one origin, and exposes only an explicit
# allowlist of files. Nginx terminates TLS and forwards everything to it.
server {
    listen 80;
    listen [::]:80;
    server_name heirloom.54-154-121-30.sslip.io;

    client_max_body_size 64k;

    location / {
        proxy_pass http://127.0.0.1:8300;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
