[Unit]
Description=Heirloom modern application
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/heirloom
ExecStart=/usr/bin/python3 /opt/heirloom/modern-app/server.py --host 127.0.0.1 --port 8300 --db /var/lib/heirloom/heirloom.sqlite3
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
